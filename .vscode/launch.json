{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (Chrome) with Firebase local env",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define-from-file=env/firebase.web.local.json"
      ]
    },
    {
      "name": "Flutter Android with Firebase local env",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define-from-file=env/firebase.android.local.json"
      ]
    }
  ]
}
